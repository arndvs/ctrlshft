#!/usr/bin/env bash
# Global git pre-push dispatcher.
# Blocks accidental pushes to the public ctrl+shft repo unless explicitly allowed,
# then delegates to local hooks (Husky, .git/hooks) when present.
#
# Copy of generic-hook for the pre-push hook.
# See pre-commit for the full dispatcher with fallback logic.

set -euo pipefail

HOOK_NAME=$(basename "$0")
REMOTE_URL="${2:-}"
DOTFILES="${DOTFILES:-$HOME/dotfiles}"

# shellcheck source=../bin/_lib.sh
source "$DOTFILES/bin/_lib.sh"

if is_public_ctrlshft_remote_url "$REMOTE_URL"; then
    if [[ "${CTRL_ALLOW_PUBLIC_PUSH:-}" != "1" ]]; then
        cat >&2 <<'MSG'
pre-push: blocked push to public ctrl+shft.

This checkout's private source of truth is dotfiles-private. The ctrlshft remote
is public/sanitized and must not receive accidental private dotfiles work.

If this push is intentional and sanitized, re-run with:
  CTRL_ALLOW_PUBLIC_PUSH=1 git push <remote> <refspec>
MSG
        exit 1
    fi

    if [[ ! -f "$DOTFILES/bin/validate-public-promotion.sh" ]]; then
        echo "pre-push: missing $DOTFILES/bin/validate-public-promotion.sh" >&2
        exit 1
    fi
    bash "$DOTFILES/bin/validate-public-promotion.sh"
fi

# ── Block direct pushes to production branches on the private origin ──────────
# main is production — dev → main promotions are human-merged via a PR, never
# pushed or force-pushed directly. This git-native guard covers EVERY local tool,
# including agents whose Claude Code PreToolUse hooks never fire (e.g. the VS Code
# Copilot agent). Scoped to the dotfiles-private origin so other repos on this
# machine are unaffected. Human break-glass: CTRL_ALLOW_MAIN_PUSH=1.
#
# Stdin handling: git passes "<local-ref> <lsha> <remote-ref> <rsha>" lines on
# stdin. Buffer all lines upfront so the while-read guard can check them without
# consuming stdin that delegated hooks (.husky/pre-push, .git/hooks/pre-push)
# also need. After the guard, restore stdin before the delegation section below.
REFS_INPUT=$(cat)
if is_private_ctrlshft_remote_url "$REMOTE_URL" && [[ "${CTRL_ALLOW_MAIN_PUSH:-}" != "1" ]]; then
    while read -r _ _ _remote_ref _; do
        case "$_remote_ref" in
            refs/heads/main | refs/heads/master)
                cat >&2 <<MSG
pre-push: blocked direct push to '${_remote_ref#refs/heads/}' on dotfiles-private.

main is production — dev → main promotions are human-merged via a pull request,
never pushed or force-pushed directly. This guard covers every local tool
(including AI agents), so an accidental or agent-driven push cannot reach main.

If you are a human performing an intentional, reviewed operation, re-run with:
  CTRL_ALLOW_MAIN_PUSH=1 git push <remote> <refspec>
MSG
                exit 1
                ;;
        esac
    done <<< "$REFS_INPUT"
fi
# Restore stdin from the buffered content so delegation hooks see the ref lines.
exec 0<<< "$REFS_INPUT"

# ── Wrong-base-merge guard (ctrlshft remotes) ────────────────────────────────
# Prevents the eval's exact failure: an agent merged origin/dev into a PR whose
# base was main, dragging ~125 unrelated files into a 4-file PR and pushing it
# to the remote. This git-native check covers every local tool (including agents
# whose PreToolUse hooks never fire). It resolves the branch's authoritative
# base and fails if the branch contains commits from a sibling base that aren't
# in the PR's actual base.
#
# Conditional on gh auth (like the ruleset check in test/branch-write-guard.sh)
# so offline/CI pushes stay green. Scoped to ctrlshft remotes so unrelated repos
# on this machine are unaffected.
if { is_public_ctrlshft_remote_url "$REMOTE_URL" || is_private_ctrlshft_remote_url "$REMOTE_URL"; } \
    && [[ "${CTRL_ALLOW_MAIN_PUSH:-}" != "1" ]] \
    && command -v gh >/dev/null 2>&1 \
    && gh auth status >/dev/null 2>&1; then
    # Only check the branch being pushed (skip base-branch pushes like dev/main).
    while read -r _local_ref _ _remote_ref _; do
        _branch="${_remote_ref#refs/heads/}"
        [[ "$_branch" == "$_remote_ref" ]] && continue  # not a branch ref
        case "$_branch" in dev|main|master) continue ;; esac
        if ! bash "$(pwd)/bin/verify-pr-base.sh" --branch "$_branch" --check-ancestry --quiet; then
            cat >&2 <<MSG
pre-push: blocked push of '$_branch' — wrong base merged in.

The branch contains commits from a sibling base that are not in its PR's actual
base. This is the wrong-base-merge failure mode (an agent once merged origin/dev
into a main-based PR, dragging ~125 unrelated files in). Rebase onto the correct
base and drop the foreign merge before pushing.

If you are a human certain this is intentional, re-run with:
  CTRL_ALLOW_MAIN_PUSH=1 git push <remote> <refspec>
MSG
            exit 1
        fi
    done <<< "$REFS_INPUT"
fi

# ── 1. Delegate to Husky if present ──────────────────────────────────────────
if [[ -f ".husky/$HOOK_NAME" ]] && [[ -x ".husky/$HOOK_NAME" ]]; then
    exec ".husky/$HOOK_NAME" "$@"
fi

# ── 2. Delegate to .git/hooks if present ─────────────────────────────────────
if [[ -x ".git/hooks/$HOOK_NAME" ]]; then
    exec ".git/hooks/$HOOK_NAME" "$@"
fi

# No global fallback for non-pre-commit hooks
exit 0
