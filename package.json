{
  "name": "ctrlshft-hud",
  "version": "0.2.0",
  "description": "ctrl+shft HUD daemon",
  "private": true,
  "main": "bin/hud-daemon.js",
  "scripts": {
    "start":   "node bin/hud-daemon.js",
    "dev":     "node bin/hud-daemon.js --debug",
    "stop":    "bash bin/start-hud.sh --stop",
    "status":  "bash bin/start-hud.sh --status",
    "test":    "bash test/run-all.sh",
    "test:fast": "bash -c \"SKIP_SLOW_TESTS=1 bash test/run-all.sh\"",
    "test:consistency": "bash test/config-consistency.sh",
    "test:branch-guard": "bash test/branch-write-guard.sh",
    "test:instructions": "bash test/claude-instructions.sh",
    "test:skills": "bash test/skills.sh",
    "test:copilot-skills": "bash test/copilot-skills-materialize.sh",
    "test:hooks": "bash test/hooks-integration.sh",
    "test:lifecycle": "bash test/lifecycle.sh",
    "test:main-pr-source": "bash test/main-pr-source-guard.sh",
    "test:pipeline-label": "bash test/pipeline-label-wrapper.sh",
    "test:bridge-python": "bash test/bridge-python.sh",
    "test:proxy-scripts": "bash shft/templates/scripts/test_probe_completion.sh",
    "test:init-sandcastle-proxy-canary": "bash test/init-sandcastle-proxy-canary.sh",
    "test:cli": "bash test/cli-smoke.sh",
    "test:smoke-report": "bash test/sandcastle-report-smoke.sh",
    "test:smoke-dispatch": "bash test/sandcastle-dispatch-smoke.sh",
    "test:smoke-issue-labels": "bash test/sandcastle-issue-label-smoke.sh",
    "test:smoke-pr-path": "bash test/sandcastle-pr-path-smoke.sh",
    "test:smoke-promote-queued": "bash test/sandcastle-promote-queued-smoke.sh",
    "test:smoke-scheduled": "bash test/sandcastle-scheduled-smoke.sh",
    "test:smoke-coverage": "bash test/sandcastle-smoke-coverage.sh",
    "test:copilot-repo-local": "bash test/copilot-repo-local-guard.sh"
  },
  "optionalDependencies": {
    "better-sqlite3": "^9.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
