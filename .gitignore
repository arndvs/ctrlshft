# macOS
.DS_Store
**/.DS_Store
._*
.Spotlight-V100
.Trashes
__MACOSX
.AppleDouble
.LSOverride
Icon?

# Python bytecode
__pycache__/
*.pyc

# Secrets — NEVER commit
secrets/*
!secrets/README.md
!secrets/.env.agent.example
!secrets/.env.bridge.example
.env
.env.*
!.env.agent.example
!.env.secrets.example
!.env.citation.example
*.vault
credentials.*

# Working/scratch — runtime state, active plans, never tracked
# working/

# Artifact source files (promoted to bin/ when shipped)
artifacts/

# Generated by bootstrap.sh from CLAUDE.base.md + local instructions
CLAUDE.md

# Node dependencies (optional better-sqlite3 for HUD)
node_modules/
package-lock.json

# Local skills and instructions (created by bootstrap.sh, tracked privately via nested git repos)
skills/_local/
instructions/_local/

/docs/docs/

dotfiles.code-workspace
global.instructions.md.bak
*.bak

# Skill/doc reference materials (large, not needed in repo)
**/references/
**/reference/
# Exception: skill-bundled references (progressive disclosure pattern)
!skills/*/references/
!skills/*/references/**
# Exception: docs/reference/ is a lifecycle directory, not bulk reference material
!docs/reference/
!docs/reference/**
# Exception: lifecycle template for downstream docs/reference/ directories
!templates/lifecycle/docs/reference/
!templates/lifecycle/docs/reference/**
# Local third-party reference dumps require HITL provenance/license review before commit
docs/reference/grndwrk/

# Client scope (keep templates/docs tracked, ignore real client data)
clients/*
!clients/README.md
!clients/_template/
!clients/_template/**
mechanisms/
shft/research/

# Artifact lifecycle — ignored runtime lanes (see docs/ARTIFACT-LIFECYCLE.md)
# Never blanket-ignore working/ — only specific subdirectories containing runtime noise.
working/runtime/
working/tmp/
working/logs/
working/runtime/afk-worktrees/
# Generated state and log patterns (loose files during migration)
working/*.log
working/*.jsonl
working/shft-state.json
working/shft-run-*.json
working/active-client.md
working/afk-iter-*-stderr.log
